<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target frameworks, version and shared package metadata come from ../Directory.Build.props. -->

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Flowtex.DataAccess</PackageId>
    <Description>A modern, streamlined data access library for Entity Framework Core that provides a clean alternative to the traditional Repository and Unit of Work patterns. Includes abstractions and base implementations for simplified data operations.</Description>
    <PackageTags>flowtex;dataaccess;entityframework;efcore;repository;unitofwork</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Each target framework binds to the EF Core major version that ships with it. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>

  <!-- A plain project reference packs as a NuGet dependency on Flowtex.DataAccess.Abstractions. -->
  <ItemGroup>
    <ProjectReference Include="..\Flowtex.DataAccess.ApplicationAbstractions\Flowtex.DataAccess.ApplicationAbstractions.csproj" />
  </ItemGroup>

</Project>
