<Project Sdk="Microsoft.NET.Sdk">

  <!-- Target frameworks, version and shared package metadata come from ../Directory.Build.props. -->

  <PropertyGroup>
    <!-- Published separately so application/domain layers can depend solely on abstractions -->
    <!-- without pulling in the EF Core transitive dependency. -->
    <IsPackable>true</IsPackable>
    <PackageId>Flowtex.DataAccess.Abstractions</PackageId>
    <Product>Flowtex Data Access Abstractions</Product>
    <Description>Application-layer abstractions for Flowtex.DataAccess. Has no EF Core dependency — safe to reference from domain or application-layer projects to preserve clean architecture layering.</Description>
    <PackageTags>flowtex;dataaccess;abstractions</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
