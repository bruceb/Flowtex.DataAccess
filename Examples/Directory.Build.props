<Project>
  <!--
    Shared settings for the sample projects. This file deliberately does not import the
    root Directory.Build.props: samples build for net10.0 only and are never packed.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
